rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Literary posts: readable by all, manageable by admin and reader claps/views
    match /posts/{postId} {
      allow read: if true;
      allow write: if true;
    }

    // Serials and novels: readable by all, manageable by admin
    match /novels/{novelId} {
      allow read: if true;
      allow write: if true;
    }

    // Reader comments: readers can submit and clap, admin can delete
    match /comments/{commentId} {
      allow read: if true;
      allow write: if true;
    }

    // Reader ratings & reviews for stories, poems, and novel episodes
    match /ratings/{ratingId} {
      allow read: if true;
      allow write: if true;
    }

    // Registered reader user profiles, activity & verification
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Newsletter subscribers: public can subscribe, admin can manage
    match /subscribers/{subscriberId} {
      allow read: if true;
      allow write: if true;
    }

    // Author profile & site settings (including pictures): readable by all, editable by admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
